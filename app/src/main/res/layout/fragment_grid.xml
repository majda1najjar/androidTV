<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- focusOutFront lets DPAD_UP escape the grid to the tab rail
         (leanback defaults it to false, which traps focus) -->
    <androidx.leanback.widget.VerticalGridView
        android:id="@+id/poster_grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp"
        app:focusOutFront="true" />

    <ProgressBar
        android:id="@+id/grid_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <TextView
        android:id="@+id/grid_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/focus_selector"
        android:gravity="center"
        android:padding="48dp"
        android:textColor="@color/text_secondary"
        android:textSize="18sp"
        android:visibility="gone" />
</FrameLayout>
